<view class="page stage-{{stage}}"><view class="welcome"><text class="eyebrow">SMART ENGLISH · 今日学习</text><view class="greeting">{{greeting}}</view><text class="muted">{{subtitle}}</text></view><view wx:if="{{!authorized}}" class="notice">请通过微信安全登录。登录后仍须由服务端确认绑定的学生身份，才可读取学习数据。<button class="login-button" bindtap="login" loading="{{loggingIn}}" disabled="{{loggingIn}}">微信安全登录</button></view><view wx:if="{{error}}" class="notice">{{error}}</view><view wx:if="{{boundStudents.length}}" class="section"><view class="heading">选择学习账号</view><button wx:for="{{boundStudents}}" wx:key="student_id" class="student-choice" data-student-id="{{item.student_id}}" bindtap="chooseStudent">{{item.display_name}} · {{item.current_stage}}</button></view><view class="hero"><view class="hero-header">今日学习计划</view><view class="hero-title">{{heroTitle}}</view><view class="muted">{{heroDescription}}</view><view class="progress-label">今日任务进度 · {{progressText}}</view><progress percent="{{progressPercent}}" activeColor="{{primary}}" stroke-width="7"/><button disabled="{{!canStart}}" bindtap="startLearning" class="start">{{startLabel}}</button></view><view class="stats"><view><text class="big">{{completedText}}</text><text>已完成任务</text></view><view><text class="big">{{minutesText}}</text><text>预计学习分钟</text></view><view><text class="big">{{pendingText}}</text><text>待完成任务</text></view></view><view class="section"><view class="heading">今天学什么</view><view wx:for="{{tasks}}" wx:key="task_id" class="task"><view>{{item.name}}</view><text>{{item.state}}</text></view><view wx:if="{{!tasks.length}}" class="quiet">暂无可展示的真实学习任务</view></view><view class="section"><view class="heading">你最近更需要关注</view><view class="quiet">{{focusText}}</view></view><view class="section"><view class="heading">学习成长</view><view class="quiet">{{growthText}}</view></view><view class="section"><view class="heading">学习目标</view><view class="quiet">{{goalText}}</view></view><view class="nav"><text>首页</text><text>学习</text><text>成长</text><text>我的</text></view></view>
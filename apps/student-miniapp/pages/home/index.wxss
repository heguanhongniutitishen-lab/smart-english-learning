page{background:#f6f9ff;color:#173454;font-family:-apple-system,'PingFang SC',sans-serif}.page{--primary:#287cf0;min-height:100vh;box-sizing:border-box;padding:38rpx 28rpx 165rpx;background:linear-gradient(#eaf4ff,#f8faff 520rpx)}.stage-Primary{--primary:#2b8af3;background:linear-gradient(#fff0d6,#fffaf3 540rpx)}.stage-Middle{--primary:#2d81f2;background:linear-gradient(#e5f3ff,#f6faff 540rpx)}.stage-High{--primary:#244f83;background:linear-gradient(#e8eff7,#f5f7fa 540rpx)}.welcome{min-height:230rpx}.eyebrow{font-size:21rpx;color:#7386a3}.greeting{font-size:45rpx;font-weight:800;margin:23rpx 0}.muted{font-size:24rpx;color:#788ba4}.hero{background:#fff;border-radius:40rpx;padding:38rpx;box-shadow:0 12rpx 35rpx #164a8810}.hero-header{font-weight:750;font-size:29rpx}.hero-title{font-size:36rpx;font-weight:800;margin:34rpx 0 12rpx}.progress-label{font-size:24rpx;color:#7b8ca5;margin:42rpx 0 16rpx}.start{background:var(--primary);color:#fff;border-radius:24rpx;margin-top:35rpx}.start[disabled]{background:#b9c5d5;color:#fff}.stats{display:flex;gap:12rpx;margin:22rpx 0 40rpx}.stats>view{flex:1;display:flex;flex-direction:column;align-items:center;background:#fff;padding:22rpx 3rpx;border-radius:26rpx;font-size:20rpx;color:#72859e}.big{font-size:37rpx;font-weight:800;color:#173454}.section{margin:42rpx 0}.heading{font-size:31rpx;font-weight:800;margin-bottom:17rpx}.task,.quiet{background:#fff;padding:28rpx;border-radius:27rpx;color:#70839b;font-size:24rpx;line-height:1.65}.task{display:flex;justify-content:space-between;margin-bottom:12rpx}.notice{background:#fff5e3;color:#8d612c;padding:24rpx;border-radius:20rpx;margin-bottom:20rpx}.nav{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:27rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));display:flex;justify-content:space-around;font-size:24rpx;color:var(--primary)}